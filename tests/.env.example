# Profile-specific serial ports.
# These names match sketch.yaml profile names uppercased by pytest-embedded.
# Examples only: remove entries for boards that are not installed. A configured
# but broken port is an error, not an equipment skip. Prefer stable by-id paths.
TEST_SERIAL_PORT_S3_PEER_HOST=/dev/ttyUSB0
TEST_SERIAL_PORT_PEER_DEVICE_S3_PEER_DEVICE=/dev/ttyUSB1
TEST_SERIAL_PORT_S3_PEER_LOCAL=/dev/ttyUSB0
TEST_SERIAL_PORT_PEER_DEVICE_S3_PEER_LOCAL=/dev/ttyUSB1
TEST_SERIAL_PORT_P4_LOOPBACK=/dev/ttyACM0
TEST_SERIAL_PORT_P4_LOOPBACK_LOCAL=/dev/ttyACM0
TEST_SERIAL_PORT_ESP32S3=/dev/ttyUSB0
TEST_SERIAL_PORT_ESP32P4=/dev/ttyACM0

# pytest options to generate an HTML report
#PYTEST_ADDOPTS="--html=report.html --self-contained-html"
