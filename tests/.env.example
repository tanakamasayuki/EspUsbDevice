# Existing S3 pair: control/log ports, independent of the OTG data cable.
# Set real stable paths for the registered, physically wired combos.
TEST_SERIAL_PORT_S3_HOST=/run/board-identify/by-id/your-s3-host
TEST_SERIAL_PORT_PEER_DEVICE_S3_DEVICE=/run/board-identify/by-id/your-s3-device

# One P4 with its native HS and FS connectors wired together.
TEST_SERIAL_PORT_P4_LOOPBACK=/run/board-identify/by-id/your-p4-loopback

# Same physical P4, separate PSRAM-enabled firmware. Run combos sequentially.
TEST_SERIAL_PORT_P4_PSRAM=/run/board-identify/by-id/your-p4-loopback

# Two-board HS peer: old P4 uses UART; P4X uses independent HWCDC/JTAG.
# Each physical board has primary-host and peer-device assignments.
# Same ports are reused only across sequential combos, never within one combo.
TEST_SERIAL_PORT_P4_HS_HOST=/run/board-identify/by-id/your-p4-uart
TEST_SERIAL_PORT_PEER_DEVICE_P4X_HS_DEVICE=/run/board-identify/by-id/your-p4x-hwcdc
TEST_SERIAL_PORT_P4X_HS_HOST=/run/board-identify/by-id/your-p4x-hwcdc
TEST_SERIAL_PORT_PEER_DEVICE_P4_HS_DEVICE=/run/board-identify/by-id/your-p4-uart

# One P4X with its native HS connector on the Linux PC (USB2 HS host).
# Control/log uses the independent HWCDC/JTAG port; the PC side uses libusb.
TEST_SERIAL_PORT_P4X_HS_PC=/run/board-identify/by-id/your-p4x-hwcdc

# S2-S3 pair: native USB of each board linked directly; control/log over each board's USB-UART.
TEST_SERIAL_PORT_S3B_HOST=/run/board-identify/by-id/your-s3b
TEST_SERIAL_PORT_PEER_DEVICE_S2_DEVICE=/run/board-identify/by-id/your-s2
TEST_SERIAL_PORT_S2_HOST=/run/board-identify/by-id/your-s2
TEST_SERIAL_PORT_PEER_DEVICE_S3B_DEVICE=/run/board-identify/by-id/your-s3b

# Not a standing pair. S2 with both connectors on the Linux PC (run with --combo primary=s2_pc): USB-UART for control/log, native USB as the device under test.
TEST_SERIAL_PORT_S2_PC=/run/board-identify/by-id/your-s2-pc
